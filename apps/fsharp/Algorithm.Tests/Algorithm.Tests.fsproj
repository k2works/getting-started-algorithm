<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="BasicAlgorithmsTests.fs" />
    <Compile Include="ArraysTests.fs" />
    <Compile Include="SearchAlgorithmsTests.fs" />
    <Compile Include="StacksAndQueuesTests.fs" />
    <Compile Include="RecursionTests.fs" />
    <Compile Include="SortAlgorithmsTests.fs" />
    <Compile Include="StringsTests.fs" />
    <Compile Include="LinkedListsTests.fs" />
    <Compile Include="TreesTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Algorithm\Algorithm.fsproj" />
  </ItemGroup>
</Project>
