●(木で)二分探索木最小値取得
    ノード一覧 = 木["nodes"]
    現在ノードID = 木["root"]
    もし、現在ノードID = -1ならば
        戻る値 = [いいえ, 0]
        戻る値を戻す
    ここまで
    現在ノード = ノード一覧の現在ノードIDを配列参照
    現在ノード["left"] ≠ -1の間
        現在ノードID = 現在ノード["left"]
        現在ノード = ノード一覧の現在ノードIDを配列参照
    ここまで
    戻る値 = [はい, 現在ノード["key"]]
    戻る値を戻す
ここまで

●(木で)二分探索木最大値取得
    ノード一覧 = 木["nodes"]
    現在ノードID = 木["root"]
    もし、現在ノードID = -1ならば
        戻る値 = [いいえ, 0]
        戻る値を戻す
    ここまで
    現在ノード = ノード一覧の現在ノードIDを配列参照
    現在ノード["right"] ≠ -1の間
        現在ノードID = 現在ノード["right"]
        現在ノード = ノード一覧の現在ノードIDを配列参照
    ここまで
    戻る値 = [はい, 現在ノード["key"]]
    戻る値を戻す
ここまで

