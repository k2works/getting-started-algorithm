# 二分探索木と最小ヒープ

●二分探索木作成
    木 = {"nodes": [], "root": -1, "size": 0}
    木を戻す
ここまで

●(キーで)二分探索木ノード作成
    {"key": キー, "left": -1, "right": -1}を戻す
ここまで

●(木とキーで)二分探索木追加
    ノード一覧 = 木["nodes"]
    もし、木["root"] = -1ならば
        ノード = キーで二分探索木ノード作成
        ノード一覧にノードを配列追加
        木["root"] = 0
        木["size"] = 1
        はいを戻す
    ここまで
    現在ノードID = 木["root"]
    探索中 = はい
    追加結果 = いいえ
    探索中の間
        現在ノード = ノード一覧の現在ノードIDを配列参照
        もし、キー = 現在ノード["key"]ならば
            探索中 = いいえ
        違えば、もし、キー < 現在ノード["key"]ならば
            もし、現在ノード["left"] = -1ならば
                ノード = キーで二分探索木ノード作成
                ノードID = ノード一覧の配列要素数
                ノード一覧にノードを配列追加
                現在ノード["left"] = ノードID
                木["size"] = 木["size"] + 1
                追加結果 = はい
                探索中 = いいえ
            違えば
                現在ノードID = 現在ノード["left"]
            ここまで
        違えば
            もし、現在ノード["right"] = -1ならば
                ノード = キーで二分探索木ノード作成
                ノードID = ノード一覧の配列要素数
                ノード一覧にノードを配列追加
                現在ノード["right"] = ノードID
                木["size"] = 木["size"] + 1
                追加結果 = はい
                探索中 = いいえ
            違えば
                現在ノードID = 現在ノード["right"]
            ここまで
        ここまで
    ここまで
    追加結果を戻す
ここまで

●(木とキーで)二分探索木探索
    ノード一覧 = 木["nodes"]
    現在ノードID = 木["root"]
    現在ノードID ≠ -1の間
        現在ノード = ノード一覧の現在ノードIDを配列参照
        もし、キー = 現在ノード["key"]ならば
            戻る値 = [はい, 現在ノード["key"]]
            戻る値を戻す
        違えば、もし、キー < 現在ノード["key"]ならば
            現在ノードID = 現在ノード["left"]
        違えば
            現在ノードID = 現在ノード["right"]
        ここまで
    ここまで
    戻る値 = [いいえ, 0]
    戻る値を戻す
ここまで

●(木とキーで)二分探索木削除
    ノード一覧 = 木["nodes"]
    対象ノードID = 木["root"]
    親ノードID = -1
    親リンク = ""
    探索中 = はい
    探索中かつ(対象ノードID ≠ -1)の間
        対象ノード = ノード一覧の対象ノードIDを配列参照
        もし、キー = 対象ノード["key"]ならば
            探索中 = いいえ
        違えば
            親ノードID = 対象ノードID
            もし、キー < 対象ノード["key"]ならば
                親リンク = "left"
                対象ノードID = 対象ノード["left"]
            違えば
                親リンク = "right"
                対象ノードID = 対象ノード["right"]
            ここまで
        ここまで
    ここまで
    もし、対象ノードID = -1ならば
        いいえを戻す
    ここまで
    対象ノード = ノード一覧の対象ノードIDを配列参照
    もし、対象ノード["left"] = -1または対象ノード["right"] = -1ならば
        もし、対象ノード["left"] = -1ならば
            子ノードID = 対象ノード["right"]
        違えば
            子ノードID = 対象ノード["left"]
        ここまで
        もし、親ノードID = -1ならば
            木["root"] = 子ノードID
        違えば
            親ノード = ノード一覧の親ノードIDを配列参照
            親ノード[親リンク] = 子ノードID
        ここまで
    違えば
        先行ノード親ID = 対象ノードID
        先行ノードID = 対象ノード["left"]
        先行ノード = ノード一覧の先行ノードIDを配列参照
        先行ノード["right"] ≠ -1の間
            先行ノード親ID = 先行ノードID
            先行ノードID = 先行ノード["right"]
            先行ノード = ノード一覧の先行ノードIDを配列参照
        ここまで
        対象ノード["key"] = 先行ノード["key"]
        もし、先行ノード親ID = 対象ノードIDならば
            対象ノード["left"] = 先行ノード["left"]
        違えば
            先行ノード親 = ノード一覧の先行ノード親IDを配列参照
            先行ノード親["right"] = 先行ノード["left"]
        ここまで
    ここまで
    木["size"] = 木["size"] - 1
    はいを戻す
ここまで

●(木とノードIDと結果で)二分探索木中順追加
    もし、ノードID = -1ならば
        結果を戻す
    ここまで
    ノード一覧 = 木["nodes"]
    ノード = ノード一覧のノードIDを配列参照
    木とノード["left"]と結果で二分探索木中順追加
    結果にノード["key"]を配列追加
    木とノード["right"]と結果で二分探索木中順追加
    結果を戻す
ここまで

