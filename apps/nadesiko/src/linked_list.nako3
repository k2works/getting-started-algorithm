# リスト構造

●線形リスト作成
    リスト = {"nodes": [], "head": -1, "size": 0}
    リストを戻す
ここまで

●(値と次ノードで)線形リストノード作成
    {"data": 値, "next": 次ノード}を戻す
ここまで

●(リストと値で)線形リスト先頭追加
    ノード一覧 = リスト["nodes"]
    ノードID = ノード一覧の配列要素数
    次ノード = リスト["head"]
    ノード = 値と次ノードで線形リストノード作成
    ノード一覧にノードを配列追加
    リスト["head"] = ノードID
    リスト["size"] = リスト["size"] + 1
    ノードIDを戻す
ここまで

●(リストと値で)線形リスト末尾追加
    もし、(リストが線形リスト空)ならば
        リストと値で線形リスト先頭追加して戻す
    ここまで
    ノード一覧 = リスト["nodes"]
    現在ノードID = リスト["head"]
    現在ノード = ノード一覧の現在ノードIDを配列参照
    現在ノード["next"] ≠ -1の間
        現在ノードID = 現在ノード["next"]
        現在ノード = ノード一覧の現在ノードIDを配列参照
    ここまで
    ノードID = ノード一覧の配列要素数
    ノード = 値と(-1)で線形リストノード作成
    ノード一覧にノードを配列追加
    現在ノード["next"] = ノードID
    リスト["size"] = リスト["size"] + 1
    ノードIDを戻す
ここまで

●(リストと値で)線形リスト探索
    ノード一覧 = リスト["nodes"]
    現在ノードID = リスト["head"]
    位置 = 0
    現在ノードID ≠ -1の間
        現在ノード = ノード一覧の現在ノードIDを配列参照
        もし、現在ノード["data"] = 値ならば
            位置を戻す
        ここまで
        現在ノードID = 現在ノード["next"]
        位置 = 位置 + 1
    ここまで
    (-1)を戻す
ここまで

●(リストの)線形リスト値一覧
    結果 = []
    ノード一覧 = リスト["nodes"]
    現在ノードID = リスト["head"]
    現在ノードID ≠ -1の間
        現在ノード = ノード一覧の現在ノードIDを配列参照
        結果に現在ノード["data"]を配列追加
        現在ノードID = 現在ノード["next"]
    ここまで
    結果を戻す
ここまで

●(リストを)線形リスト先頭削除
    もし、(リストが線形リスト空)ならば
        戻る値 = [いいえ, 0]
        戻る値を戻す
    ここまで
    ノード一覧 = リスト["nodes"]
    ノードID = リスト["head"]
    ノード = ノード一覧のノードIDを配列参照
    リスト["head"] = ノード["next"]
    リスト["size"] = リスト["size"] - 1
    戻る値 = [はい, ノード["data"]]
    戻る値を戻す
ここまで

●(リストを)線形リスト末尾削除
    もし、(リストが線形リスト空)ならば
        戻る値 = [いいえ, 0]
        戻る値を戻す
    ここまで
    もし、リスト["size"] = 1ならば
        リストを線形リスト先頭削除して戻す
    ここまで
    ノード一覧 = リスト["nodes"]
    現在ノードID = リスト["head"]
    現在ノード = ノード一覧の現在ノードIDを配列参照
    現在ノード["next"] ≠ -1の間
        前ノード = 現在ノード
        現在ノードID = 現在ノード["next"]
        現在ノード = ノード一覧の現在ノードIDを配列参照
    ここまで
    前ノード["next"] = -1
    リスト["size"] = リスト["size"] - 1
    戻る値 = [はい, 現在ノード["data"]]
    戻る値を戻す
ここまで

●(リストが)線形リスト空
    (リスト["size"] = 0)を戻す
ここまで

●(リストの)線形リストサイズ
    リスト["size"]を戻す
ここまで

●双方向リスト作成
    番兵 = {"data": 0, "prev": 0, "next": 0, "active": はい}
    リスト = {"nodes": [番兵], "size": 0}
    リストを戻す
ここまで

●(値と前ノードと次ノードで)双方向リストノード作成
    {"data": 値, "prev": 前ノード, "next": 次ノード, "active": はい}を戻す
ここまで

●(リストと値と前ノードと次ノードで)双方向リスト挿入
    ノード一覧 = リスト["nodes"]
    ノードID = ノード一覧の配列要素数
    ノード = 値と前ノードと次ノードで双方向リストノード作成
    ノード一覧にノードを配列追加
    前ノード = ノード一覧の前ノードを配列参照
    次ノード = ノード一覧の次ノードを配列参照
    前ノード["next"] = ノードID
    次ノード["prev"] = ノードID
    リスト["size"] = リスト["size"] + 1
    ノードIDを戻す
ここまで

●(リストと値で)双方向リスト先頭追加
    ノード一覧 = リスト["nodes"]
    番兵 = ノード一覧の0を配列参照
    次ノード = 番兵["next"]
    リストと値と0と次ノードで双方向リスト挿入して戻す
ここまで

●(リストと値で)双方向リスト末尾追加
    ノード一覧 = リスト["nodes"]
    番兵 = ノード一覧の0を配列参照
    前ノード = 番兵["prev"]
    リストと値と前ノードと0で双方向リスト挿入して戻す
ここまで

●(リストの)双方向リスト値一覧
    結果 = []
    ノード一覧 = リスト["nodes"]
    番兵 = ノード一覧の0を配列参照
    現在ノードID = 番兵["next"]
    現在ノードID ≠ 0の間
        現在ノード = ノード一覧の現在ノードIDを配列参照
        結果に現在ノード["data"]を配列追加
        現在ノードID = 現在ノード["next"]
    ここまで
    結果を戻す
ここまで

●(リストの)双方向リスト逆順値一覧
    結果 = []
    ノード一覧 = リスト["nodes"]
    番兵 = ノード一覧の0を配列参照
    現在ノードID = 番兵["prev"]
    現在ノードID ≠ 0の間
        現在ノード = ノード一覧の現在ノードIDを配列参照
        結果に現在ノード["data"]を配列追加
        現在ノードID = 現在ノード["prev"]
    ここまで
    結果を戻す
ここまで

●(リストとノードIDで)双方向リスト削除
    ノード一覧 = リスト["nodes"]
    ノード数 = ノード一覧の配列要素数
    もし、ノードID < 1またはノードID ≧ ノード数ならば
        いいえを戻す
    ここまで
    ノード = ノード一覧のノードIDを配列参照
    もし、ノード["active"] = いいえならば
        いいえを戻す
    ここまで
    前ノード = ノード一覧の(ノード["prev"])を配列参照
    次ノード = ノード一覧の(ノード["next"])を配列参照
    前ノード["next"] = ノード["next"]
    次ノード["prev"] = ノード["prev"]
    ノード["active"] = いいえ
    リスト["size"] = リスト["size"] - 1
    はいを戻す
ここまで

●(リストを)双方向リスト先頭削除
    もし、(リストが双方向リスト空)ならば
        戻る値 = [いいえ, 0]
        戻る値を戻す
    ここまで
    ノード一覧 = リスト["nodes"]
    番兵 = ノード一覧の0を配列参照
    ノードID = 番兵["next"]
    ノード = ノード一覧のノードIDを配列参照
    値 = ノード["data"]
    リストとノードIDで双方向リスト削除
    戻る値 = [はい, 値]
    戻る値を戻す
ここまで

●(リストが)双方向リスト空
    (リスト["size"] = 0)を戻す
ここまで

●(リストの)双方向リストサイズ
    リスト["size"]を戻す
ここまで
