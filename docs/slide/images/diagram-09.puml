@startuml
title クイックソートの分割統治

rectangle "[5,2,8,1,9,3,7,4]" as r0
rectangle "[2,1,3,4]" as rL #ffeecc
rectangle "[5,8,9,7]" as rR #ccffcc

rectangle "[1,2]" as rLL
rectangle "[3,4]" as rLR
rectangle "[5,7]" as rRL
rectangle "[8,9]" as rRR

r0 --> rL : ピボット未満
r0 --> rR : ピボット以上

rL --> rLL
rL --> rLR
rR --> rRL
rR --> rRR
@enduml
